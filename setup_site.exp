#!/usr/bin/expect -f
# This script automates the `bench new-site` command.

# Set a timeout for expect commands.
set timeout 60

# Get the site name from the first command-line argument.
set site [lindex $argv 0]

# Start the `bench new-site` command.
spawn bench new-site $site

# Expect the prompt for the super user. The `*` is a glob pattern.
expect "Enter mysql super user*:"

# Send a newline character (\r) to accept the default 'root' user.
send "\r"

# Expect the prompt for the password.
expect "MySQL root password: "

# Send a dummy password.
send "dummy_password\r"

# Wait for the command to complete.
expect eof 