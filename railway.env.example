# Database Configuration (Railway MySQL)
# These are automatically provided by Railway if you have a MySQL service in the same project
# Only set these if using an external database
# MYSQLHOST=your-mysql-host
# MYSQLPORT=3306
# MYSQLDATABASE=your-database-name
# MYSQLUSER=your-mysql-user
# MYSQLPASSWORD=your-mysql-password

# Site Configuration
SITE_NAME=your-site-name.railway.app
ADMIN_PASSWORD=your-secure-admin-password

# Application Configuration
PORT=8000
FRAPPE_SITE_NAME=your-site-name.railway.app

# Security (Generate secure keys)
ENCRYPTION_KEY=your-32-character-encryption-key
SECRET_KEY=your-secret-key

# Optional Redis Configuration (if using external Redis)
REDIS_CACHE=redis://localhost:6379
REDIS_QUEUE=redis://localhost:6379
REDIS_SOCKETIO=redis://localhost:6379 